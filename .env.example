# Copy to .env and change every secret before deployment.
POSTGRES_PASSWORD=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://dera:replace-with-a-long-random-secret@postgres:5432/dera
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:8000
SCAN_TIMEOUT_SECONDS=10
SCAN_RATE_LIMIT=10/minute
ENVIRONMENT=development
